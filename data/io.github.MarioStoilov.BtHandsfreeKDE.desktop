[Desktop Entry]
Type=Application
Name=BT Handsfree
GenericName=Phone call controller
Comment=Answer, reject and place phone calls over Bluetooth from the system tray
Exec=bt-handsfree-kde %u
Icon=io.github.MarioStoilov.BtHandsfreeKDE
Terminal=false
Categories=Utility;Telephony;Qt;KDE;
MimeType=x-scheme-handler/tel;
Keywords=bluetooth;handsfree;hfp;phone;call;dial;
StartupNotify=false
